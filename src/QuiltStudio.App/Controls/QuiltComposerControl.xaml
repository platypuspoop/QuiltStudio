<UserControl x:Class="QuiltStudio.App.Controls.QuiltComposerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Background="#FFEAEAEA">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Margin="24" BorderBrush="#FFB0B0B0" BorderThickness="1" Background="White">
                <Canvas x:Name="Surface" Background="White" MouseLeftButtonDown="Surface_OnMouseLeftButtonDown" />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
