<Window x:Class="QuiltStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuiltStudio.App.Controls"
        Title="QuiltStudio" Height="900" Width="1440" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="NewProject_Click" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Click="OpenProject_Click" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Click="SaveProject_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Click="SaveProjectAs_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Delete" Click="Delete_Click" InputGestureText="Del" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About QuiltStudio" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="DirtyText" /></StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs">
            <TabItem Header="Block Designer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="TOOLS" FontWeight="Bold" Margin="4,2,4,8" />
                            <RadioButton x:Name="SelectTool" Content="Select" GroupName="Tools" Margin="5" Checked="Tool_Checked" Tag="Select" />
                            <RadioButton x:Name="LineTool" Content="Line" GroupName="Tools" Margin="5" Checked="Tool_Checked" Tag="Line" IsChecked="True" />
                            <RadioButton x:Name="VertexTool" Content="Vertex" GroupName="Tools" Margin="5" Checked="Tool_Checked" Tag="Vertex" />
                            <RadioButton x:Name="ColorPickerTool" Content="Fabric color eyedropper" GroupName="Tools" Margin="5" Checked="Tool_Checked" Tag="ColorPicker" />
                            <Separator Margin="0,10" />
                            <CheckBox x:Name="SnapCheck" Content="Snap to grid" IsChecked="True" Margin="5" Checked="SnapCheck_Changed" Unchecked="SnapCheck_Changed" />
                            <TextBlock Text="Zoom" Margin="5,10,5,0" />
                            <Slider x:Name="ZoomSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="False" ValueChanged="ZoomSlider_ValueChanged" />
                            <TextBlock x:Name="ZoomLabel" Text="100%" HorizontalAlignment="Center" />
                            <Separator Margin="0,10" />
                            <Button Content="Undo" Click="Undo_Click" />
                            <Button Content="Redo" Click="Redo_Click" />
                            <Button Content="Delete selected line" Click="Delete_Click" />
                            <TextBlock Text="Tip: right-click or Esc cancels a line. Ctrl+mouse wheel zooms." TextWrapping="Wrap" Foreground="DimGray" Margin="5,14,5,0" />
                        </StackPanel>
                    </Border>

                    <controls:BlockEditorControl x:Name="BlockEditor" Grid.Column="1" />

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="BLOCK" FontWeight="Bold" Margin="4,2,4,8" />
                                <TextBlock Text="Name" />
                                <TextBox x:Name="BlockNameBox" LostFocus="BlockProperties_LostFocus" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Width (in)" />
                                        <TextBox x:Name="BlockWidthBox" LostFocus="BlockProperties_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Height (in)" />
                                        <TextBox x:Name="BlockHeightBox" LostFocus="BlockProperties_LostFocus" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Grid size (in)" Margin="0,8,0,0" />
                                <ComboBox x:Name="GridSizeCombo" SelectionChanged="GridSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="1" Tag="1" />
                                    <ComboBoxItem Content="1/2" Tag="0.5" />
                                    <ComboBoxItem Content="1/4" Tag="0.25" IsSelected="True" />
                                    <ComboBoxItem Content="1/8" Tag="0.125" />
                                    <ComboBoxItem Content="1/16" Tag="0.0625" />
                                </ComboBox>

                                <Separator Margin="0,14" />
                                <TextBlock Text="SOURCE IMAGE" FontWeight="Bold" />
                                <TextBlock Text="Import a photo or drawing and trace directly over it. Automatic simplification/vectorization is the next image-engine milestone." TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,8" />
                                <Button Content="Import image..." Click="ImportImage_Click" />
                                <Button Content="Remove image" Click="RemoveImage_Click" />
                                <TextBlock x:Name="ImageNameText" Text="No image loaded" TextWrapping="Wrap" Margin="4" />
                                <TextBlock Text="Image opacity" Margin="4,8,4,0" />
                                <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="100" Value="45" ValueChanged="ImageOpacitySlider_ValueChanged" />

                                <Separator Margin="0,14" />
                                <TextBlock Text="FABRIC COLOR MATCH" FontWeight="Bold" />
                                <TextBlock Text="Use the Fabric color eyedropper on an imported image, or type a hex color. QuiltStudio finds the closest starter-catalog solids using perceptual color distance." TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,8" />
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="TargetColorSwatch" Grid.Column="0" Width="44" Height="32" BorderBrush="#FF777777" BorderThickness="1" Background="#FF808080" CornerRadius="3" />
                                    <TextBox x:Name="TargetHexBox" Grid.Column="1" Text="#808080" VerticalContentAlignment="Center" LostFocus="TargetHexBox_LostFocus" />
                                </Grid>
                                <TextBlock Text="Brand" />
                                <ComboBox x:Name="FabricBrandCombo" Margin="2,3,2,5" SelectionChanged="FabricBrandCombo_SelectionChanged" />
                                <Button Content="Match Fabric Color" Click="MatchFabric_Click" FontWeight="Bold" />
                                <ListBox x:Name="FabricMatchList" MinHeight="170" MaxHeight="235" Margin="2,6,2,2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" Background="{Binding Hex}" BorderBrush="#FF888888" BorderThickness="1" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ColorName}" FontWeight="SemiBold" />
                                                    <TextBlock FontSize="10" Foreground="DimGray">
                                                        <Run Text="{Binding Brand}"/><Run Text=" - "/><Run Text="{Binding Line}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Sku}" FontSize="10" Foreground="DimGray" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding MatchText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Screen matches are approximate. Verify against a physical manufacturer color card and current dye lot before purchasing fabric." TextWrapping="Wrap" Foreground="DimGray" FontSize="10" Margin="2,3,2,4" />

                                <Separator Margin="0,14" />
                                <TextBlock Text="FPP OUTPUT" FontWeight="Bold" />
                                <TextBlock Text="Creates a mirrored, full-size FPP template with a 1/4-inch seam allowance, page tiling, registration marks, and a 1-inch calibration square." TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,6" />
                                <Button Content="CREATE &amp; PRINT FPP PATTERN" Click="PrintFpp_Click" FontWeight="Bold" FontSize="13" Padding="12,10" />
                                <TextBlock Text="Choose Microsoft Print to PDF in the Windows print dialog to save a PDF." TextWrapping="Wrap" Foreground="DimGray" FontSize="10" Margin="2,3,2,4" />

                                <Separator Margin="0,14" />
                                <TextBlock Text="BLOCKS" FontWeight="Bold" />
                                <ListBox x:Name="BlocksList" MinHeight="120" SelectionChanged="BlocksList_SelectionChanged" DisplayMemberPath="Name" />
                                <Button Content="New block" Click="AddBlock_Click" />
                                <Button Content="Duplicate block" Click="DuplicateBlock_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Quilt Composer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="QUILT" FontWeight="Bold" Margin="4,2,4,8" />
                                <TextBlock Text="Reference size" />
                                <ComboBox x:Name="QuiltSizeCombo" SelectionChanged="QuiltSizeCombo_SelectionChanged" DisplayMemberPath="Name" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Width (in)" /><TextBox x:Name="QuiltWidthBox" LostFocus="QuiltDimensions_LostFocus" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Height (in)" /><TextBox x:Name="QuiltHeightBox" LostFocus="QuiltDimensions_LostFocus" /></StackPanel>
                                </Grid>
                                <TextBlock Text="Reference sizes vary by pattern and desired drop; these values are starting points." TextWrapping="Wrap" Foreground="DimGray" Margin="4,6" />

                                <Separator Margin="0,12" />
                                <TextBlock Text="BLOCK LAYOUT" FontWeight="Bold" />
                                <ComboBox x:Name="ComposerBlockCombo" DisplayMemberPath="Name" Margin="2,6" />
                                <Button Content="Add one block" Click="AddInstance_Click" />
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Rows" /><TextBox x:Name="RowsBox" Text="2" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Columns" /><TextBox x:Name="ColumnsBox" Text="2" /></StackPanel>
                                </Grid>
                                <Button Content="Build repeated grid" Click="BuildGrid_Click" />
                                <TextBlock Text="Build repeated grid replaces the current layout using reusable instances of the selected block." TextWrapping="Wrap" Foreground="DimGray" Margin="4,4,4,8" />

                                <Separator Margin="0,12" />
                                <TextBlock Text="SELECTED INSTANCE" FontWeight="Bold" />
                                <Button Content="Copy" Click="CopyInstance_Click" />
                                <Button Content="Paste" Click="PasteInstance_Click" />
                                <Button Content="Duplicate" Click="DuplicateInstance_Click" />
                                <Button Content="Rotate 90°" Click="RotateInstance_Click" />
                                <Button Content="Mirror horizontal" Click="MirrorH_Click" />
                                <Button Content="Mirror vertical" Click="MirrorV_Click" />
                                <Button Content="Delete" Click="DeleteInstance_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <controls:QuiltComposerControl x:Name="QuiltComposer" Grid.Column="1" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
